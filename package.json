{
  "name": "yubrio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios:development": "npx eas-cli@latest build --profile development --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsc --ignoreConfig --target ES2022 --module commonjs --strict --skipLibCheck --outDir .test-build src/lib/validation/rules.ts && node --test tests/*.test.js"
  },
  "dependencies": {
    "@expo/cli": "^57.0.20",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.59.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.15",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
