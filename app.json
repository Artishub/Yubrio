{
  "expo": {
    "name": "Roomhop",
    "slug": "roomhop",
    "scheme": "roomhop",
    "extra": { "deepLinkDomains": ["roomhop.com", "roomhop.app"] },
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-notifications",
      ["expo-camera", { "cameraPermission": "Allow Roomhop to use your camera to add friends." }],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roomhop.app"
    },
    "android": {
      "package": "com.roomhop.app"
    }
  }
}
